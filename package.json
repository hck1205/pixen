{
  "name": "pixen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/web packages/react",
    "typecheck": "tsc -b packages/core packages/web packages/react",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "playground": "pnpm --filter @pixen/playground dev",
    "playground:build": "pnpm --filter @pixen/playground build",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo apps/*/dist test-results playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
